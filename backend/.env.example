# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_SERVER=localhost
POSTGRES_PORT=5555
POSTGRES_DB=highland_coffee

# Async & Sync Database URLs
# For async FastAPI (asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5555/highland_coffee
# For sync Alembic / Seed scripts (psycopg2 / psycopg)
SYNC_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5555/highland_coffee

# Security / JWT
SECRET_KEY=change-this-to-a-very-secure-random-secret-key-in-production-highland-coffee-2025
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Project Settings
PROJECT_NAME="Highlands Coffee"
API_V1_STR=/api
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Initial Admin Credentials (for seed script)
INITIAL_ADMIN_EMAIL=admin@highland.vn
INITIAL_ADMIN_PASSWORD=Admin@123456
INITIAL_ADMIN_NAME="Highlands Administrator"
INITIAL_ADMIN_PHONE=0901234567
